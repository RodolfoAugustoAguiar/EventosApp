<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventosApp.Views.CadastroEventoPage"
             Title="Cadastro de Eventos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nome do evento" FontAttributes="Bold" />
            <Entry Placeholder="Ex.: Congresso de Tecnologia"
                   Text="{Binding NomeEvento}" />

            <Label Text="Data de início" FontAttributes="Bold" />
            <DatePicker Date="{Binding DataInicio}" Format="dd/MM/yyyy" />

            <Label Text="Data de término" FontAttributes="Bold" />
            <DatePicker Date="{Binding DataTermino}" Format="dd/MM/yyyy" />

            <Label Text="Número de participantes" FontAttributes="Bold" />
            <Entry Keyboard="Numeric" Placeholder="0"
                   Text="{Binding NumeroParticipantes}" />

            <Label Text="Local do evento" FontAttributes="Bold" />
            <Entry Placeholder="Ex.: Centro de Convenções"
                   Text="{Binding LocalEvento}" />

            <Label Text="Custo por participante (R$)" FontAttributes="Bold" />
            <Entry Keyboard="Numeric" Placeholder="0,00"
                   Text="{Binding CustoPorParticipante}" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0,8" />

            <!-- Pré-visualização calculada em tempo real -->
            <Label Text="{Binding DuracaoTexto, StringFormat='Duração: {0}'}" />
            <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}" />

            <Button Text="Cadastrar evento"
                    Clicked="OnCadastrarClicked"
                    Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
