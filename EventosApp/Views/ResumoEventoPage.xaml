<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventosApp.Views.ResumoEventoPage"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="{Binding NomeEvento}" FontSize="24" FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="Gray" />

            <Label Text="{Binding LocalEvento, StringFormat='Local: {0}'}" />
            <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />
            <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" />
            <Label Text="{Binding DuracaoTexto, StringFormat='Duração: {0}'}" />
            <Label Text="{Binding Duracao, StringFormat='Diferença entre as datas (TimeSpan): {0:%d} dia(s)'}"
                   FontSize="12" TextColor="Gray" />

            <BoxView HeightRequest="1" Color="Gray" />

            <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0:N0}'}" />
            <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C}'}" />
            <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}"
                   FontSize="20" FontAttributes="Bold" />

            <Button Text="Novo cadastro" Clicked="OnVoltarClicked" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
